rules_version = '2';

// Arc's memory is written only by the Arc server (Firebase Admin SDK, which bypasses these rules).
// Browsers may read their own conversations and memories, never anyone else's, and may write nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
